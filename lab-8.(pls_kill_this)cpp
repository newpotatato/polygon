bool dfs(const Node& current, const Node& target, 
            unordered_set<Node, NodeHash>& visited, 
            vector<Node>& path, 
            vector<Node>& best_path) {
        if (visited.find(current) != visited.end()) {
            return false; // Узел уже посещен
        }
        visited.insert(current); 
        path.push_back(current); 

        if (current == target) {
            if (best_path.empty() || path.size() < best_path.size()) {
                best_path = path; // Обновляем кратчайший путь
            }
        } else {
            for (const auto& neighbor : adj[current]) {
                if (visited.find(neighbor.first) == visited.end()) {
                    dfs(neighbor.first, target, visited, path, best_path);
                }
            }
        }

        path.pop_back();
        visited.erase(current);
        return !best_path.empty(); 
    }


