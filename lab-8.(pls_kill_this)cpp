        }
    }




void dijkstra(const Node& start, const Node& target) {

    unordered_map<Node, float, NodeHash> distances;
    for (const auto& entry : adj) {
        distances[entry.first] = numeric_limits<float>::max();
    }
    distances[start] = 0; 
    using PQElement = pair<float, Node>;
    priority_queue<PQElement, vector<PQElement>, greater<>> pq;
    pq.push({0, start});
    unordered_set<Node, NodeHash> visited;
    unordered_map<Node, Node, NodeHash> previous;

    while (!pq.empty()) {
        auto [currentDistance, currentNode] = pq.top();
        pq.pop();
        if (visited.find(currentNode) != visited.end()) continue;

        visited.insert(currentNode);
        if (currentNode == target) break;
        for (const auto& neighbor : adj[currentNode]) {
            const Node& neighborNode = neighbor.first;
            float weight = neighbor.second;

            if (visited.find(neighborNode) == visited.end()) {
                float newDistance = currentDistance + weight;
                if (newDistance < distances[neighborNode]) {
                    distances[neighborNode] = newDistance;
                    pq.push({newDistance, neighborNode});
                    previous[neighborNode] = currentNode;
                }
            }
        }
    }

    if (distances[target] < numeric_limits<float>::max()) {
        cout << "Кратчайший путь найден: расстояние = " << distances[target] << endl;
        vector<Node> path;
        for (Node at = target; at != start; at = previous[at]) {
            path.push_back(at);
        }
        path.push_back(start);
        for (size_t i = 0, j = path.size() - 1; i < j; ++i, --j) {
    swap(path[i], path[j]);
}
        cout << "Путь: ";
        for (const auto& node : path) {
            cout << "(" << node.x << ", " << node.y << ") ";
        }
        cout << endl;
    } else {
        cout << "мы не попадём на пары(" << endl;
    }
}


    void time_for_DFS(Graph& graph, const Node& start, const Node& target) {
        unordered_set<Node, NodeHash> visited;
        vector<Node> path, best_path;
        auto startTime = chrono::high_resolution_clock::now();
        graph.dfs(start, target, visited, path, best_path);
        auto endTime = chrono::high_resolution_clock::now(); 
        auto duration = chrono::duration_cast<chrono::microseconds>(endTime - startTime).count();
        cout << "Время выполнения DFS: " << duration << " мкс" << endl;
    }

    void time_for_BFS(Graph& graph, const Node& start, const Node& target) {
        vector<Node> path;
        auto startTime = chrono::high_resolution_clock::now(); 
        graph.bfs(start, target, path);
        auto endTime = chrono::high_resolution_clock::now(); 
        auto duration = chrono::duration_cast<chrono::microseconds>(endTime - startTime).count();
        cout << "Время выполнения BFS: " << duration << " мкс" << endl;
    }

    void time_for_Dijkstra(Graph& graph, const Node& start, const Node& target) {
        auto startTime = chrono::high_resolution_clock::now(); 
        graph.dijkstra(start, target);
        auto endTime = chrono::high_resolution_clock::now();
        auto duration = chrono::duration_cast<chrono::microseconds>(endTime - startTime).count();
        cout << "Время выполнения Дейкстры: " << duration << " мкс" << endl;
    }

   
};

