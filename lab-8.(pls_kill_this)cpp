struct Graph {
    map<Node, vector<pair<Node, float>>> adj;

    void addEdge(const Node& u, const Node& v, float weight) {
        adj[u].push_back({v, weight}); 
        adj[v].push_back({u, weight}); 
    }
    bool findNode(const vector<Node>& visited, const Node& value) {
        for (const auto& node : visited) {
            if (node == value) {
                return true;
            }
        }
        return false;
    }


    float pifagor(Node node, Node homeID) {
        return sqrt((node.x - homeID.x) * (node.x - homeID.x) + (node.y - homeID.y) * (node.y - homeID.y));
    }

    Node closestUzel(){
        float minDist = numeric_limits<float>::max();
        float dist;
        Node closestNode;
        for (const auto& entry : adj) {
            const Node& node = entry.first;
            dist = pifagor(node, homeID);
            if (dist < minDist){
                minDist = dist;
                closestNode = node;
            }
        }

        cout << fixed << setprecision(7) << "(" << closestNode.x << ", " << closestNode.y << ") ";

        return closestNode;
    }

    bool bfs(const Node& start, const Node& target, vector<Node>& path) {
        unordered_set<Node, NodeHash> visited; 
        unordered_map<Node, Node, NodeHash> parent; 

        queue<Node> q; 
        q.push(start);
        visited.insert(start);

        while (!q.empty()) {
            Node current = q.front();
            q.pop();

            if (current == target) {
                Node step = target;
                while ((step == start) == false) {
                    path.push_back(step);
                    step = parent[step];
                }
                path.push_back(start);
                for (size_t i = 0, j = path.size() - 1; i < j; ++i, --j) {
    swap(path[i], path[j]);
}
                return true;
            }
            for (const auto& neighbor : adj[current]) {
                if (visited.find(neighbor.first) == visited.end()) {
                    visited.insert(neighbor.first);
                    parent[neighbor.first] = current;
                    q.push(neighbor.first);
                }
            }
        }
        return false; 
    }

